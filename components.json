{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-vega",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "hugeicons",
  "rtl": false,
  "aliases": {
    "components": "src/reui-reference/components",
    "utils": "src/reui-reference/lib/utils",
    "ui": "src/reui-reference/components/ui",
    "lib": "src/reui-reference/lib",
    "hooks": "src/reui-reference/hooks"
  },
  "menuColor": "default",
  "menuAccent": "bold",
  "registries": {
    "@reui": {
      "url": "https://reui.io/r/{style}/{name}.json",
      "headers": {
        "Authorization": "Bearer ${REUI_LICENSE_KEY}"
      }
    }
  }
}
